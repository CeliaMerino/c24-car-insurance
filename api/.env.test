# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> partner simulator ###
# The contract test in specs/06-testing.md section 6 calls the simulator's own
# endpoint through the test kernel, so the /sim routes exist here.
APP_SIMULATOR_ENABLED=1

# specs/06-testing.md section 2: the seed is fixed for the whole run.
PARTNER_SIMULATION_SEED=20260831

# Scaled down for the same reason the timeouts are (specs/06-testing.md
# section 4): a forced slow partner must still be slower than the scaled
# per-partner timeout, without costing seconds per test.
PARTNER_FORCED_SLOW_MS=150
PARTNER_FORCED_TIMEOUT_MS=250
###< partner simulator ###
