{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Is it working?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(c24_comparisons_total[5m])) * 60",
          "legendFormat": "comparisons / min",
          "refId": "A"
        }
      ],
      "title": "Comparisons per minute",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" } },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 10, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(c24_comparison_offers_bucket{le=\"0\"}[5m])) / sum(rate(c24_comparison_offers_count[5m]))",
          "legendFormat": "0 offers",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(c24_comparison_offers_bucket{le=\"2\"}[5m])) - sum(rate(c24_comparison_offers_bucket{le=\"0\"}[5m]))) / sum(rate(c24_comparison_offers_count[5m]))",
          "legendFormat": "1–2 offers",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(c24_comparison_offers_bucket{le=\"3\"}[5m])) - sum(rate(c24_comparison_offers_bucket{le=\"2\"}[5m]))) / sum(rate(c24_comparison_offers_count[5m]))",
          "legendFormat": "3 offers",
          "refId": "C"
        },
        {
          "expr": "(sum(rate(c24_comparison_offers_bucket{le=\"4\"}[5m])) - sum(rate(c24_comparison_offers_bucket{le=\"3\"}[5m]))) / sum(rate(c24_comparison_offers_count[5m]))",
          "legendFormat": "4 offers",
          "refId": "D"
        }
      ],
      "title": "Share of comparisons by offer count",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rate(c24_comparison_offers_bucket{le=\"0\"}[10m])) / sum(rate(c24_comparison_offers_count[10m]))",
          "refId": "A"
        }
      ],
      "title": "Empty result rate",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "panels": [],
      "title": "Is it fast?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(c24_comparison_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(c24_comparison_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(c24_comparison_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Comparison duration percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "orange", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (partner, le) (rate(c24_partner_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ partner }}",
          "refId": "A"
        }
      ],
      "title": "Per-partner p95 latency (2s marker)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "panels": [],
      "title": "Which partner?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.9 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (partner) (rate(c24_partner_requests_total{status=\"ok\"}[5m])) / sum by (partner) (rate(c24_partner_requests_total[5m]))",
          "legendFormat": "{{ partner }}",
          "refId": "A"
        }
      ],
      "title": "Success rate per partner (90% threshold)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" } },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (status) (rate(c24_partner_requests_total[5m]))",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ],
      "title": "Partner outcomes by status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (partner) (rate(c24_circuit_breaker_opened_total[5m]))",
          "legendFormat": "{{ partner }}",
          "refId": "A"
        }
      ],
      "title": "Circuit breaker opens",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "panels": [],
      "title": "Are customers getting through?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(c24_frontend_events_total{event=\"form_started\"}[5m]))",
          "legendFormat": "form started",
          "refId": "A"
        },
        {
          "expr": "sum(rate(c24_comparisons_total[5m]))",
          "legendFormat": "comparison run",
          "refId": "B"
        },
        {
          "expr": "sum(rate(c24_frontend_events_total{event=\"results_viewed\"}[5m]))",
          "legendFormat": "results viewed",
          "refId": "C"
        }
      ],
      "title": "Funnel: form → comparison → results",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 10,
      "targets": [
        {
          "expr": "topk(5, sum by (field) (rate(c24_validation_errors_total[5m])))",
          "legendFormat": "{{ field }}",
          "refId": "A"
        }
      ],
      "title": "Validation errors by field (top 5)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (coverage) (rate(c24_comparisons_total[5m]))",
          "legendFormat": "{{ coverage }}",
          "refId": "A"
        }
      ],
      "title": "Coverage tier distribution",
      "type": "timeseries"
    }
  ],
